{
  "name": "Aganitha Cognitive Solutions",
  "install": "./.cursor/install.sh",
  "terminals": [
    {
      "name": "api-server",
      "command": "bash -lc 'source \"$HOME/.venv/aganitha/bin/activate\" && uvicorn aganitha_cognitive_solutions.app:app --host 0.0.0.0 --port 8000 --reload'"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    }
  ]
}
