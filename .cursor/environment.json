{
  "name": "MicroscopyAI",
  "install": "./.cursor/install.sh",
  "terminals": [
    {
      "name": "api-server",
      "command": "bash -lc 'source \"$HOME/.venv/microscopyai/bin/activate\" && uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload'"
    },
    {
      "name": "frontend",
      "command": "bash -lc 'cd frontend && npm run dev -- --host 0.0.0.0 --port 5173'"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "frontend", "port": 5173 }
  ]
}
